class imageObject {
    constructor(app){
        this.app = app
        this.img = null
        this.width = null
        this.height = null
        this.size = [this.width,this.height]
    }
    _synchronization_size(){
        this.width = this.img.width
        this.height = this.img.height
    }
    
    async load(path){
        this.img = await this.app.loadImage(path);
        this._synchronization_size()
    }


    
}